load("//tools:cpplint.bzl", "cpplint")
load("//tools:rules_cc.bzl", "lightrat_cc_binary", "lightrat_cc_library", "lightrat_cc_shared_library", "lightrat_cc_static_library")
load("//tools:variables.bzl", "LIGHTRAT_DESCRIPTION", "LIGHTRAT_NAME", "LIGHTRAT_VERSION")
load("@rules_pkg//pkg:install.bzl", "pkg_install")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files")
load("@bazel_skylib//rules:expand_template.bzl", "expand_template")

expand_template(
    name = "generate_version_header",
    out = "version.h",
    substitutions = {
        "@LIGHTRAT_NAME@": LIGHTRAT_NAME,
        "@LIGHTRAT_VERSION@": LIGHTRAT_VERSION,
        "@LIGHTRAT_VERSION_MAJOR@": LIGHTRAT_VERSION.split(".")[0],
        "@LIGHTRAT_VERSION_MINOR@": LIGHTRAT_VERSION.split(".")[1],
        "@LIGHTRAT_VERSION_PATCH@": LIGHTRAT_VERSION.split(".")[2],
        "@LIGHTRAT_DESCRIPTION@": LIGHTRAT_DESCRIPTION,
    },
    template = ":version.h.in",
)

lightrat_cc_library(
    name = "version",
    hdrs = [":generate_version_header"],
)

lightrat_cc_library(
    name = "hash",
    hdrs = ["hash.h"],
    deps = [
        "@gmp",
        "@gmp//:gmpxx",
    ],
)

lightrat_cc_library(
    name = "errors",
    hdrs = ["errors.h"],
)

lightrat_cc_library(
    name = "concepts",
    hdrs = ["concepts.h"],
)

lightrat_cc_library(
    name = "rational",
    srcs = [
        "MpqStore.hpp",
        "Rational.cpp",
        "lightrat.cpp",
    ],
    hdrs = [
        "Rational.h",
        "lightrat.h",
    ],
    implementation_deps = [
        ":errors",
        ":hash",
    ],
    deps = [
        ":concepts",
        "@gmp",
        "@gmp//:gmpxx",
    ],
)

lightrat_cc_library(
    name = "lightrat",
    hdrs = ["lightrat.hpp"],
    visibility = ["//visibility:public"],
    deps = [
        ":errors",
        ":rational",
        ":version",
    ],
)

lightrat_cc_binary(
    name = "lightrat_bin",
    srcs = ["main.cpp"],
    visibility = ["//visibility:public"],
    deps = [":lightrat"],
)

lightrat_cc_shared_library(
    name = "lightrat_shared",
    deps = [":lightrat"],
)

lightrat_cc_static_library(
    name = "lightrat_static",
    deps = [":lightrat"],
)

pkg_files(
    name = "headers",
    srcs = [":generate_version_header"] + glob([
        "**/*.h",
        "**/*.hpp",
    ]),
    prefix = "include/lightrat",
)

pkg_files(
    name = "libs",
    srcs = [
        ":lightrat_shared",
        ":lightrat_static",
    ],
    prefix = "lib",
    renames = select({
        "@platforms//os:windows": {
            ":lightrat_shared": "lightrat.dll",
            ":lightrat_static": "lightrat.lib",
        },
        "@platforms//os:linux": {
            ":lightrat_shared": "liblightrat.so",
            ":lightrat_static": "liblightrat.a",
        },
        "@platforms//os:macos": {
            ":lightrat_shared": "liblightrat.dylib",
            ":lightrat_static": "liblightrat.a",
        },
    }),
)

pkg_install(
    name = "install",
    srcs = [
        ":headers",
        ":libs",
    ],
)

cpplint()
