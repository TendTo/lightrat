module(name = "lightrat_examples")

bazel_dep(name = "lightrat")
local_path_override(
    module_name = "lightrat",
    path = "../",
)

bazel_dep(name = "rules_cc", version = "0.2.28")
bazel_dep(name = "rules_python", version = "2.4.6")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")

python.toolchain(python_version = "3.10")

use_repo(python, "python_3_10")
